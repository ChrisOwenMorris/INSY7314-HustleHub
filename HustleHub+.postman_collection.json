				{
					"name": "Register - Successful Freelancer Registration",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 201', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('Response indicates success', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status || jsonData.success).to.satisfy(function (val) {",
									"        return val === 'success' || val === true;",
									"    });",
									"});",
									"",
									"pm.test('Password is not present in response', function () {",
									"    var responseText = pm.response.text();",
									"    pm.expect(responseText).to.not.include('SecurePass1');",
									"    pm.expect(responseText.toLowerCase()).to.not.include('\"password\"');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"janedoe\",\n    \"email\": \"jane@example.com\",\n    \"password\": \"SecurePass1\",\n    \"role\": \"freelancer\"\n}"
