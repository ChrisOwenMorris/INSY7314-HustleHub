									"var jsonData = pm.response.json();",
									"",
									"pm.test('Token exists in response', function () {",
									"    pm.expect(jsonData.data && jsonData.data.token).to.exist;",
									"});",
									"",
									"pm.test('User data returned without password', function () {",
									"    pm.expect(jsonData.data && jsonData.data.user).to.exist;",
									"    pm.expect(jsonData.data.user).to.not.have.property('password');",
									"});",
									"",
									"if (jsonData.data && jsonData.data.token) {",
									"    pm.collectionVariables.set('authToken', jsonData.data.token);",
									"}"
								]
							}
						}
